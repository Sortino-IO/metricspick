---
import { getEntry } from "astro:content";
import ArticlePage from "../../components/ArticlePage.astro";
import { pathsFor } from "../../lib/sectionPaths";

export async function getStaticPaths() {
  return pathsFor("pricing");
}

const article = await getEntry("articles", Astro.props.id);
if (!article) {
  throw new Error(`Missing article ${Astro.props.id}`);
}
---
<ArticlePage article={article} />
