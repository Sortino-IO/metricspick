---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---
<Base title="Page not found" description="That page is not on metricspick." noindex={true}>
  <main id="main">
    <header class="article-hero">
      <div class="wrap">
        <p class="kicker">404</p>
        <h1>That page is not here</h1>
        <p class="lede">The link may be old, or the guide may live under a section path such as /alternatives/ or /pricing/.</p>
        <div class="hero-actions">
          <Button href="/">Back home</Button>
          <Button href="/alternatives/" variant="secondary">Browse alternatives</Button>
        </div>
      </div>
    </header>
  </main>
</Base>
