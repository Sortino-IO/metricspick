---
import { getCollection } from "astro:content";
import GuideList from "../../components/GuideList.astro";
import Simple from "../../layouts/Simple.astro";
import { visitIdsForArticle } from "../../data/catalog";

const articles = (await getCollection("articles", ({ data }) => data.section === "reviews")).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<Simple
  title="Analytics Reviews"
  description="Analytics reviews for founders, starting with DataFast. See what the product does, what it costs, and when Plausible, Fathom, GA4, or PostHog is the better fit."
  kicker="Reviews"
  lede="A review here covers the public product: price, docs, and who it is for. DataFast fits revenue by channel. It is a poor fit for session replay, feature flags, or Google Ads."
  crumbs={[{ href: "/", label: "Home" }, { label: "Reviews" }]}
>
  <p>DataFast is the first review because it is the revenue tool this site recommends, and because some links to it earn a commission. The review is about datafa.st, Marc Lou's analytics product. It is not the Arizona IT company and it is not the Ecuador payments company that share the name. The price ladder lives on the <a href="/pricing/datafast/">DataFast pricing</a> page.</p>
  <p>Other products are covered in the <a href="/alternatives/">alternatives</a>, <a href="/compare/">compare</a>, and <a href="/pricing/">pricing</a> sections.</p>
  <section slot="wide" class="band band-yellow">
    <div class="article-wide">
      <h2>Analytics reviews</h2>
      <GuideList
        items={articles.map((article) => ({
          href: `/${article.id}/`,
          title: article.data.title,
          description: article.data.description,
          visits: visitIdsForArticle(article.id),
        }))}
      />
    </div>
  </section>
</Simple>
