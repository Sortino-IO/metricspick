---
import Button from "./Button.astro";
import { datafastUrl } from "../config/site";

interface Props {
  path?: string;
  placement: string;
  /** Standalone offer CTA. In-sentence links use "text". */
  variant?: "button" | "text";
  size?: "md" | "sm";
  class?: string;
}
const { path = "/", placement, variant = "button", size = "sm", class: className } = Astro.props;
const href = datafastUrl(path);
const buttonClass = ["datafast-cta", className].filter(Boolean).join(" ");
---
{variant === "button" ? (
  <Button
    href={href}
    size={size}
    class={buttonClass}
    rel="sponsored nofollow noopener"
    target="_blank"
    placement={placement}
  >
    <slot />
  </Button>
) : (
  <a href={href} class={className} rel="sponsored nofollow noopener" target="_blank" data-placement={placement}>
    <slot />
  </a>
)}
