---
import { datafastUrl } from "../config/site";

interface Props {
  path?: string;
  placement: string;
  /** Standalone offer CTA. In-sentence links use "text". */
  variant?: "button" | "text";
  class?: string;
}
const { path = "/", placement, variant = "button", class: className } = Astro.props;
const href = datafastUrl(path);
const classes = [variant === "button" ? "btn btn-primary btn-sm datafast-cta" : undefined, className]
  .filter(Boolean)
  .join(" ");
---
<a
  href={href}
  class={classes || undefined}
  rel="sponsored nofollow noopener"
  target="_blank"
  data-placement={placement}
>
  <slot />
</a>
