---
import VisitTool from "./VisitTool.astro";
import { toolsNamedIn, type ToolId } from "../data/catalog";

interface Job {
  title: string;
  body: string;
  who: string;
}
interface Props {
  jobs: Job[];
}
const { jobs } = Astro.props;
const seen = new Set<ToolId>();
const cards = jobs.map((job) => {
  const visits = toolsNamedIn(job.who).filter((id) => {
    if (seen.has(id)) return false;
    seen.add(id);
    return true;
  });
  return { ...job, visits };
});
---
<section class="band band-blue" aria-labelledby="which-tool-fits">
  <div class="article-wide">
    <h2 id="which-tool-fits">Which tool fits</h2>
    <p class="band-lede">A short way to shortlist. The bars under the cards show where the choice usually gets stuck. They are an illustration, not a survey.</p>
    <div class="jobs">
      {cards.map((job) => (
        <article class="job">
          <h3>{job.title}</h3>
          <p>{job.body}</p>
          <span class="who">{job.who}</span>
          {job.visits.length > 0 && (
            <div class="visit-row">
              {job.visits.map((id) => <VisitTool id={id} placement="pick-job" />)}
            </div>
          )}
        </article>
      ))}
    </div>
    <div class="mini-bars">
      <h3>Where the choice usually gets stuck</h3>
      <div class="bars" aria-hidden="true">
        <div class="bar-row"><span class="name">Attribution</span><div class="track"><div class="fill w78"></div></div><span class="amt">Often</span></div>
        <div class="bar-row"><span class="name">Complexity</span><div class="track"><div class="fill w62"></div></div><span class="amt">GA4</span></div>
        <div class="bar-row"><span class="name">Privacy setup</span><div class="track"><div class="fill w44"></div></div><span class="amt">Mid</span></div>
        <div class="bar-row"><span class="name">Product depth</span><div class="track"><div class="fill w28"></div></div><span class="amt">Rare</span></div>
      </div>
      <p class="mini-note">Layout illustration only. Not survey data, a score, or a measured result.</p>
    </div>
  </div>
</section>
