---
import Button from "./Button.astro";
import VisitTool from "./VisitTool.astro";
import { tools, type ToolId } from "../data/catalog";

interface Card {
  id: ToolId;
  title?: string;
  blurb: string;
  cta: string;
  href?: string;
  placement?: string;
  featured?: boolean;
  secondaryHref?: string;
  secondaryCta?: string;
}
interface Props {
  cards: Card[];
}
const { cards } = Astro.props;
---
<section class="band band-cream" aria-labelledby="tools-title">
  <div class="article-wide">
    <h2 id="tools-title">Tools worth a closer look</h2>
    <div class="tool-cards">
      {cards.map((card) => {
        const tool = tools[card.id];
        const affiliate = Boolean(tool.affiliate);
        const secondaryHref = card.secondaryHref ?? (affiliate ? undefined : (card.href ?? tool.href));
        const secondaryCta = card.secondaryCta ?? (affiliate ? undefined : card.cta);
        return (
          <article class:list={["tool-card", card.featured && "is-featured"]}>
            <div>
              <h3>{card.title ?? tool.name}</h3>
              <p>{card.blurb}</p>
              {tool.priceLabel && <p class="price">{tool.priceLabel}</p>}
            </div>
            <div class="card-actions">
              <VisitTool id={card.id} placement={card.placement ?? "article-card"} />
              {secondaryHref && secondaryCta && (
                <Button href={secondaryHref} variant="secondary" size="sm">{secondaryCta}</Button>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
