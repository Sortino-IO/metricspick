---
import { priceSources, type SourceLink } from "../data/catalog";
import { isDatafastHref, withAffiliate } from "../config/site";

interface Props {
  extra?: SourceLink[];
  /** Show only this article's links, not the shared price catalog. */
  exclusive?: boolean;
}
const { extra = [], exclusive = false } = Astro.props;
const seen = new Set<string>();
const links = (exclusive ? extra : [...extra, ...priceSources]).filter((link) => {
  if (seen.has(link.href)) return false;
  seen.add(link.href);
  return true;
});
---
<section class="band band-cream" aria-labelledby="sources-title">
  <div class="article-body">
    <h2 id="sources-title">Sources</h2>
    {!exclusive && <p>Prices and product details link to the vendor pages below. DataFast links include the affiliate parameter.</p>}
    <ul class="sources">
      {links.map((link) => {
        const href = withAffiliate(link.href);
        const affiliate = isDatafastHref(link.href);
        return (
          <li>
            <a
              href={href}
              rel={affiliate ? "sponsored nofollow noopener" : "noopener"}
              target="_blank"
              data-placement={affiliate ? "article-source" : undefined}
            >{link.label}</a>
          </li>
        );
      })}
      {!exclusive && <li><a href="/how-we-test/">How MetricsPick checks pages</a></li>}
    </ul>
  </div>
</section>
