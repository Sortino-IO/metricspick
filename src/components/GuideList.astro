---
import Button from "./Button.astro";

interface Item {
  href: string;
  title: string;
  description: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---
<ul class="guides">
  {
    items.map((item) => (
      <li>
        <article class="guide">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <Button href={item.href} variant="secondary" size="sm" label={`Read guide: ${item.title}`}>
            Read guide
          </Button>
        </article>
      </li>
    ))
  }
</ul>
