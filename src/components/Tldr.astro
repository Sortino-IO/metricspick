---
import { renderMarkdown } from "../lib/markdown";

interface Props {
  items: string[];
  note?: string;
  title?: string;
}
const { items, note, title = "TL;DR" } = Astro.props;
const headingId = title === "TL;DR" ? "tldr-title" : title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

function inline(source: string): string {
  return renderMarkdown(source).trim().replace(/^<p>|<\/p>$/g, "");
}
---
<section class="band band-cream">
  <div class="article-body">
    <aside class="tldr" aria-labelledby={headingId}>
      <h2 id={headingId}>{title}</h2>
      <ul>
        {items.map((item) => <li set:html={inline(item)} />)}
      </ul>
      {note && <p class="tldr-note">{note}</p>}
    </aside>
  </div>
</section>
